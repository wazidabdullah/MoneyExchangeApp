<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moneyexchangeapp.BusinessCollaboratorRepresentative.CustomerController">
    <children>
        <Label layoutX="35.0" layoutY="31.0" text="com.example.moneyexchangeapp.Customer KYC Validation">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <Label layoutX="35.0" layoutY="83.0" text="Full Name" />
        <TextField fx:id="customerNameField" layoutX="136.0" layoutY="79.0" prefHeight="25.0" prefWidth="233.0" />

        <Label layoutX="35.0" layoutY="126.0" text="Document ID" />
        <TextField fx:id="docIdField" layoutX="136.0" layoutY="122.0" prefHeight="25.0" prefWidth="233.0" promptText="Passport / NID" />

        <Button layoutX="136.0" layoutY="175.0" mnemonicParsing="false" onAction="#onReviewKYC" text="Review KYC Data" />
        <Button layoutX="269.0" layoutY="175.0" mnemonicParsing="false" onAction="#onCheckAMLFlags" text="Check AML Flags" />

        <Label fx:id="kycStatusLabel" layoutX="35.0" layoutY="243.0" prefHeight="17.0" prefWidth="400.0" text="System Idle..." textFill="#616161" />
    </children>
</AnchorPane>