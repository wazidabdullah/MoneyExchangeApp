<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moneyexchangeapp.BusinessCollaboratorRepresentative.CurrencyController">
    <children>
        <Label layoutX="32.0" layoutY="33.0" text="Exchange Rate Manager">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <Label layoutX="32.0" layoutY="88.0" text="Currency Pair" />
        <TextField fx:id="currencyPairField" layoutX="130.0" layoutY="84.0" prefHeight="25.0" prefWidth="199.0" promptText="e.g. USD/GBP" />

        <Button layoutX="130.0" layoutY="129.0" mnemonicParsing="false" onAction="#onFetchRealTimeRates" text="Fetch Real-Time Rates" />
        <Button layoutX="282.0" layoutY="129.0" mnemonicParsing="false" onAction="#onValidateKey" text="Validate API" />

        <Label fx:id="rateLabel" layoutX="32.0" layoutY="198.0" prefHeight="27.0" prefWidth="300.0" text="Rate will appear here..." textFill="#1d61ae">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
    </children>
</AnchorPane>