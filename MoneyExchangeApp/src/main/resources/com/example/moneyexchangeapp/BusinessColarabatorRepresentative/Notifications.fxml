<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moneyexchangeapp.BusinessCollaboratorRepresentative.NotificationController">
    <children>
        <Label layoutX="42.0" layoutY="35.0" text="Notification Center">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="42.0" layoutY="88.0" text="Target User ID" />
        <TextField fx:id="userIdField" layoutX="150.0" layoutY="84.0" prefHeight="25.0" prefWidth="200.0" promptText="e.g. USER-101" />

        <Label layoutX="42.0" layoutY="130.0" text="Department" />
        <TextField fx:id="departmentField" layoutX="150.0" layoutY="126.0" prefHeight="25.0" prefWidth="200.0" promptText="e.g. Compliance" />

        <Label layoutX="42.0" layoutY="175.0" text="Message Body" />
        <TextArea fx:id="messageArea" layoutX="42.0" layoutY="200.0" prefHeight="100.0" prefWidth="516.0" promptText="Type your alert here..." />

        <Button layoutX="42.0" layoutY="318.0" mnemonicParsing="false" onAction="#onSendUserAlert" text="Send User Alert" />
        <Button layoutX="165.0" layoutY="318.0" mnemonicParsing="false" onAction="#onNotifyDepartment" text="Email Department" />

        <Label fx:id="statusLabel" layoutX="42.0" layoutY="360.0" prefHeight="17.0" prefWidth="400.0" text="Ready to send..." textFill="#6b6b6b" />
    </children>
</AnchorPane>