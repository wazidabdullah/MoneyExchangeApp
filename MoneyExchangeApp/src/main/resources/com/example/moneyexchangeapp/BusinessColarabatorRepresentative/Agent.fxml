<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moneyexchangeapp.BusinessCollaboratorRepresentative.AgentController">
    <children>
        <Label layoutX="42.0" layoutY="34.0" text="Agent Portal">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="42.0" layoutY="69.0" text="Business Collaborator Interface" textFill="#868686" />

        <Label layoutX="42.0" layoutY="116.0" text="Collaborator ID" />
        <TextField fx:id="collaboratorIdField" layoutX="42.0" layoutY="139.0" prefHeight="25.0" prefWidth="288.0" />

        <Label layoutX="364.0" layoutY="116.0" text="API Key" />
        <TextField fx:id="apiKeyField" layoutX="364.0" layoutY="139.0" prefHeight="25.0" prefWidth="288.0" />

        <Button layoutX="42.0" layoutY="199.0" mnemonicParsing="false" onAction="#onApproveTransaction" prefHeight="35.0" prefWidth="145.0" text="Approve Transaction" />
        <Button layoutX="203.0" layoutY="199.0" mnemonicParsing="false" onAction="#onMonitorRisk" prefHeight="35.0" prefWidth="110.0" text="Monitor Risk" />
        <Button layoutX="330.0" layoutY="199.0" mnemonicParsing="false" onAction="#onReconcile" prefHeight="35.0" prefWidth="110.0" text="Reconcile" />
        <Button layoutX="456.0" layoutY="199.0" mnemonicParsing="false" onAction="#onInitiateSettlement" prefHeight="35.0" prefWidth="196.0" text="Initiate Settlement" />

        <Label layoutX="42.0" layoutY="267.0" text="System Logs" />
        <TextArea fx:id="logArea" layoutX="42.0" layoutY="291.0" prefHeight="177.0" prefWidth="610.0" />
    </children>
</AnchorPane>