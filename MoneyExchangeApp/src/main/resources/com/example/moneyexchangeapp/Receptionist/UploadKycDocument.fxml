<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Receptionist.UploadKycDocumentController">
   <children>
      <Label layoutX="206.0" layoutY="20.0" text="Upload KYC Document">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="133.0" layoutY="137.0" text="Document Type" />
      <Label layoutX="291.0" layoutY="84.0" text="Document Number" />
      <Label layoutX="14.0" layoutY="84.0" text="Document Path" />
      <TextField fx:id="txtDocPath" layoutX="109.0" layoutY="80.0" />
      <TextField fx:id="txtDocNumber" layoutX="416.0" layoutY="80.0" />
      <Button fx:id="btnSelectDoc" layoutX="115.0" layoutY="187.0" mnemonicParsing="false" onAction="#handleSelectDocument" text="Select Document" />
      <Button fx:id="btnUploadDoc" layoutX="390.0" layoutY="187.0" mnemonicParsing="false" onAction="#handleUploadDocument" text="Upload Document" />
      <ComboBox fx:id="cmbDocType" layoutX="244.0" layoutY="133.0" prefWidth="150.0" />
      <Label fx:id="lblKycStatus" layoutX="32.0" layoutY="241.0" text="Status" />
   </children>
</AnchorPane>
