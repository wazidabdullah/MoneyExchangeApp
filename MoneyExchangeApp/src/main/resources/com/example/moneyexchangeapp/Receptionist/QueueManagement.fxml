<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Receptionist.QueueManagementController">
   <children>
      <Label layoutX="198.0" layoutY="14.0" text="com.example.moneyexchangeapp.Customer Queue Management">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label layoutX="66.0" layoutY="52.0" text="Token No" />
      <Label layoutX="42.0" layoutY="90.0" text="com.example.moneyexchangeapp.Customer Name" />
      <Label layoutX="52.0" layoutY="127.0" text="Service Type" />
      <Label layoutX="69.0" layoutY="161.0" text="Status" />
      <TextField fx:id="txtTokenNo" layoutX="143.0" layoutY="48.0" />
      <TextField fx:id="txtCustomerName" layoutX="143.0" layoutY="86.0" />
      <Button fx:id="btnRefreshQueue" layoutX="331.0" layoutY="144.0" mnemonicParsing="false" onAction="#handleRefreshQueue" text="Refresh Queue" />
      <Button fx:id="btnServe" layoutX="331.0" layoutY="48.0" mnemonicParsing="false" onAction="#handleMarkServing" text="Mark as Being Served" />
