        </columns>
      </TableView>
      <ComboBox fx:id="comboServiceType" layoutX="143.0" layoutY="123.0" prefWidth="150.0" />
      <TextField fx:id="txtStatus" layoutX="143.0" layoutY="157.0" />
   </children>
</AnchorPane>
