<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.moneyexchangeapp.BackupAndRestoreController">
   <children>
      <Label layoutX="51.0" layoutY="53.0" text="Backup Destination" />
      <Label layoutX="66.0" layoutY="112.0" text="Backup Progress" />
      <Label layoutX="219.0" layoutY="14.0" text="Backup &amp; Restore">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Button fx:id="btnStartBackup" layoutX="424.0" layoutY="49.0" mnemonicParsing="false" text="Start Backup" />
      <ComboBox fx:id="cbDestination" layoutX="162.0" layoutY="49.0" prefWidth="150.0" />
      <Button fx:id="btnRestore" layoutX="424.0" layoutY="108.0" mnemonicParsing="false" text="Restore Backup" />
      <ProgressBar fx:id="progressBackup" layoutX="162.0" layoutY="112.0" prefWidth="200.0" progress="0.0" />
      <Label fx:id="lblBackupStatus" layoutX="237.0" layoutY="191.0" text="Status Message" />
   </children>
</AnchorPane>
