      <TableView fx:id="tblAudit" layoutX="141.0" layoutY="221.0" prefHeight="122.0" prefWidth="331.0">
        <columns>
          <TableColumn fx:id="colIssueType" prefWidth="75.0" text="Issue Type" />
          <TableColumn fx:id="colTransId" prefWidth="92.0" text="Transaction ID" />
            <TableColumn fx:id="colDetails" prefWidth="83.33331298828125" text="Details" />
