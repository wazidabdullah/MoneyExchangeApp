      <Button fx:id="btnSaveCorrection" layoutX="133.0" layoutY="106.0" mnemonicParsing="false" onAction="#handleSave" text="Save Correction" />
      <TextField fx:id="txtCorrectValue" layoutX="86.0" layoutY="166.0" />
